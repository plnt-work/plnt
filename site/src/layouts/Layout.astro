---
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  path?: string;
}

const { title, description, path = '/' } = Astro.props;
const canonical = new URL(path, Astro.site).toString();
const repo = 'https://github.com/plnt-work/plnt';
const nav = [
  { href: '/playground', label: 'Playground' },
  { href: '/docs/', label: 'Docs' },
  { href: `${repo}/blob/main/ROADMAP.md`, label: 'Roadmap' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'plnt',
  description:
    'Open-source runtime for shipping one AI agent to many customers, each isolated, on any model, local or cloud.',
  applicationCategory: 'DeveloperApplication',
  license: 'https://www.apache.org/licenses/LICENSE-2.0',
  url: 'https://plnt.work',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="plnt" />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <header class="site-nav">
      <div class="container inner">
        <a href="/" class="brand">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7 20h10" /><path d="M10 20c5.5-2.5.8-6.4 3-10" />
            <path d="M9.5 9.4c1.1.8 1.8 2.2 2.3 3.7-2 .4-3.5.4-4.8-.3-1.2-.6-2.3-1.9-3-4.2 2.8-.5 4.4 0 5.5.8z" />
            <path d="M14.1 6a7 7 0 0 0-1.1 4c1.9-.1 3.3-.6 4.3-1.4 1-1 1.6-2.3 1.7-4.6-2.7.1-4 1-4.9 2z" />
          </svg>
          plnt
        </a>
        <nav>
          {nav.map((n) => (
            <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
        <div class="right">
          <a class="btn" href={repo} target="_blank" rel="noopener">GitHub</a>
        </div>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container inner">
        <div>
          <a href="/docs/">Docs</a>
          <a href="/playground">Playground</a>
          <a href={repo}>GitHub</a>
          <a href="/privacy">Privacy</a>
          <a href="/terms">Terms</a>
        </div>
        <div class="muted">Apache-2.0 · pre-alpha</div>
      </div>
    </footer>
  </body>
</html>
